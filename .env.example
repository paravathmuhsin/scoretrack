# Public site URL for shared links (live match, overlay). Required in Capacitor builds.
VITE_PUBLIC_APP_URL=https://scoretrackonline.com

# Google Play listing (Android install modal). Leave unset for the default Play URL.
# Set to empty to hide the in-browser install prompt.
# VITE_ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.scoretrackonline.app

# Firebase web app (scoretrack-48b01 → ScoreTrack). Same values for web + Capacitor WebView.
# Copy to .env — these are client-side public config (not secrets).
VITE_FIREBASE_API_KEY=AIzaSyCErJ5lD1IQ94AiXEMyjTnqWfIEOjb0JKc
# Custom Auth domain (must be listed under Firebase Auth → Settings → Authorized domains).
# Fallback for local testing: scoretrack-48b01.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=scoretrackonline.com
VITE_FIREBASE_PROJECT_ID=scoretrack-48b01
VITE_FIREBASE_STORAGE_BUCKET=scoretrack-48b01.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=132743863881
VITE_FIREBASE_APP_ID=1:132743863881:web:b63a7bb28c64c56633a998
