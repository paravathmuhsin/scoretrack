# Copy to .env.staging and fill empty VITE_FIREBASE_* from Firebase Console:
# scoretrack-staging → Project settings → Your apps → scoretrack-web-staging
#
# Staging web app URL (Firebase Hosting default domain).
VITE_PUBLIC_APP_URL=https://scoretrack-staging.web.app

# Hide Android APK download prompt on staging.
# Hide Android Play Store install prompt on staging.
VITE_ANDROID_PLAY_STORE_URL=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=scoretrack-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=scoretrack-staging
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
